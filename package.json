{
	"name": "dukat",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"db:seed": "pnpm --filter @dukat/db db:seed",
		"dev": "turbo run dev",
		"format": "prettier --write .",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"test:e2e": "pnpm --filter @dukat/e2e test",
		"lint-staged": "lint-staged",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,cjs,mjs,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.astro": "prettier --write",
		"*.{json,md}": "prettier --write"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@dukat/eslint-config": "workspace:*",
		"@eslint/compat": "catalog:",
		"eslint": "catalog:",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "^3.5.2",
		"turbo": "^2.9.6",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.18.0",
	"engines": {
		"node": ">=18"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	}
}
