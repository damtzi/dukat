---
import { Button } from '@dukat/ui';

import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="min-h-screen bg-background text-foreground">
		<section class="mx-auto flex min-h-screen w-full max-w-6xl flex-col justify-center px-6 py-24">
			<p class="text-sm font-semibold tracking-[0.3em] text-muted-foreground uppercase">Template</p>
			<div class="mt-6 max-w-3xl space-y-6">
				<h1 class="text-5xl font-bold tracking-tight text-balance md:text-7xl">
					A SvelteKit + Astro monorepo starter.
				</h1>
				<p class="max-w-2xl text-lg leading-8 text-muted-foreground">
					Use this Astro website for public pages, and share shadcn-svelte components with your
					SvelteKit apps through the workspace UI package.
				</p>
			</div>

			<div class="mt-10 flex flex-wrap gap-3">
				<Button>Shared UI button</Button>
				<a
					class="inline-flex h-9 items-center rounded-md border px-4 py-2 text-sm font-medium hover:bg-accent hover:text-accent-foreground"
					href="/example"
				>
					Example route
				</a>
			</div>
		</section>
	</main>
</Layout>
