{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "dukat",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-06",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "../dashboard/build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"triggers": {
		"crons": []
	},
	"vars": {
		"NODE_ENV": "production",
		"LOG_LEVEL": "info"
	},
	"observability": {
		"enabled": true
	},
	"env": {
		"preview": {
			"workers_dev": true,
			"preview_urls": false,
			"vars": {
				"NODE_ENV": "production",
				"LOG_LEVEL": "info"
			}
		}
	}
}
