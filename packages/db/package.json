{
	"name": "@dukat/db",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "tsx src/commands/migrate.ts",
		"db:backup": "tsx src/commands/backup.ts",
		"db:restore": "tsx src/commands/restore.ts",
		"db:check": "tsx src/commands/check.ts",
		"check-types": "tsc --noEmit",
		"test": "tsx --test src/*.test.ts"
	},
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"@dukat/typescript-config": "workspace:*",
		"@types/node": "^24.13.3",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.23.1",
		"typescript": "catalog:"
	}
}
