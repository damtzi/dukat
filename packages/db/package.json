{
	"name": "@dukat/db",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:release": "drizzle-kit migrate",
		"db:backup": "tsx src/recovery-cli.ts backup",
		"db:restore": "tsx src/recovery-cli.ts restore",
		"db:integrity": "tsx src/recovery-cli.ts integrity",
		"ledger:purge-trash": "tsx src/ledger-lifecycle-cli.ts",
		"test": "tsx --test src/repositories/*.test.ts",
		"check-types": "tsc --noEmit"
	},
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"@dukat/env": "workspace:*",
		"better-auth": "^1.6.11",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@dukat/typescript-config": "workspace:*",
		"@types/node": "^22.15.3",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.7.1",
		"typescript": "catalog:"
	}
}
