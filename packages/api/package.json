{
	"name": "@dukat/api",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"check-types": "tsc --noEmit",
		"test": "tsx --test src/middleware/*.test.ts src/routes/**/*.test.ts"
	},
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"devDependencies": {
		"@dukat/db": "workspace:*",
		"@dukat/typescript-config": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"tsx": "^4.7.1",
		"typescript": "catalog:"
	},
	"dependencies": {
		"@dukat/core": "workspace:*",
		"@dukat/env": "workspace:*",
		"@hono/structured-logger": "^0.1.0",
		"@hono/zod-openapi": "^1.4.0",
		"@scalar/hono-api-reference": "^0.10.19",
		"hono": "^4.12.23",
		"http-status-codes": "^2.3.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"zod": "^4.4.3"
	}
}
