{
	"extends": "@dukat/typescript-config/svelte-library.json",
	"compilerOptions": {
		"strictNullChecks": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"#lib/*": ["./src/lib/*"],
			"#lib/*.js": ["./src/lib/*.ts"],
			"#components/*": ["./src/components/*"],
			"#hooks/*": ["./src/hooks/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "eslint.config.mjs", "svelte.config.js"],
	"exclude": ["dist", "node_modules"]
}
