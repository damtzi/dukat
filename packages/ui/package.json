{
	"name": "@repo/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"svelte": "./src/index.ts",
	"imports": {
		"#lib/*": "./src/lib/*.ts",
		"#lib/*.js": "./src/lib/*.ts",
		"#components/*": "./src/components/*",
		"#hooks/*": "./src/hooks/*"
	},
	"exports": {
		".": {
			"svelte": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./styles/globals.css": "./src/styles/globals.css",
		"./styles/theme.css": "./src/styles/theme.css",
		"./components/ui/button": {
			"svelte": "./src/components/ui/button/index.ts",
			"types": "./src/components/ui/button/index.ts",
			"default": "./src/components/ui/button/index.ts"
		},
		"./lib/*": "./src/lib/*.ts"
	},
	"scripts": {
		"lint": "eslint . --max-warnings 0",
		"check-types": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@lucide/svelte": "catalog:",
		"@repo/utils": "workspace:*",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"shadcn-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"svelte": ">=5"
	}
}
