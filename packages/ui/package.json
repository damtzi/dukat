{
	"name": "@dukat/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"svelte": "./src/index.ts",
	"imports": {
		"#lib/*": "./src/lib/*.ts",
		"#lib/*.js": "./src/lib/*.ts",
		"#components/*": "./src/components/*",
		"#hooks/*": "./src/hooks/*"
	},
	"exports": {
		".": {
			"svelte": "./src/index.ts",
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./styles/globals.css": "./src/styles/globals.css",
		"./styles/theme.css": "./src/styles/theme.css",
		"./components/ui/button": {
			"svelte": "./src/components/ui/button/index.ts",
			"types": "./src/components/ui/button/index.ts",
			"default": "./src/components/ui/button/index.ts"
		},
		"./lib/*": "./src/lib/*.ts"
	},
	"scripts": {
		"lint": "eslint . --max-warnings 0",
		"check-types": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@dukat/utils": "workspace:*",
		"clsx": "^2.1.1",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "catalog:",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@dukat/eslint-config": "workspace:*",
		"@dukat/typescript-config": "workspace:*",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@internationalized/date": "^3.12.2",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"bits-ui": "^2.18.1",
		"phosphor-svelte": "^3.1.0",
		"shadcn-svelte": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwind-variants": "^3.3.1",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"svelte": ">=5"
	}
}
