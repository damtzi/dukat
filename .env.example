# Node/server
NODE_ENV=development
LOG_LEVEL=info
DASHBOARD_DIRECTORY=../dashboard/build
PROFILE_IMAGE_DIRECTORY=./data/profile-images

# Production profile images (dedicated public S3-compatible bucket)
PROFILE_IMAGE_S3_ENDPOINT=https://s3.example.com
PROFILE_IMAGE_S3_REGION=eu-central-1
PROFILE_IMAGE_S3_ACCESS_KEY_ID=profile-images-access-key
PROFILE_IMAGE_S3_SECRET_ACCESS_KEY=profile-images-secret-key
PROFILE_IMAGE_S3_BUCKET=dukat-profile-images
PROFILE_IMAGE_PUBLIC_BASE_URL=https://images.example.com

# Database
TURSO_DATABASE_URL=file:/absolute/path/to/dukat.db
TURSO_AUTH_TOKEN=
BACKUP_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:9999
CORS_ORIGIN=http://localhost:3001

# Resend
RESEND_API_KEY=re_your-api-key
AUTH_EMAIL_FROM="Dukat <auth@example.com>"
