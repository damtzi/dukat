# Node/server
NODE_ENV=development
LOG_LEVEL=info

# Database (local development; use libsql:// plus a token for Turso)
DATABASE_URL=file:../../data/dukat.db
DATABASE_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
RESEND_API_KEY=re_...
AUTH_EMAIL_FROM=Dukat <auth@example.com>

# Same-origin dashboard
DASHBOARD_ASSETS_DIR=../dashboard/build

# Recovery (generate with: openssl rand -base64 32)
BACKUP_ENCRYPTION_KEY=
BACKUP_PATH=backups/dukat.backup
RESTORE_DATABASE_URL=file:../../data/restored.db
RESTORE_DATABASE_AUTH_TOKEN=
